# --- QMetry: one shared service account for every team ----------------------
# Pick the base URL matching where your Jira Cloud site's data resides:
#   US:        https://qtmcloud.qmetry.com
#   Australia: https://syd-qtmcloud.qmetry.com
#   Germany:   https://eu-qtm4j-cloud.qmetry.com
QMETRY_BASE_URL=https://qtmcloud.qmetry.com

# Jira account used for Basic auth (any Jira user with QMetry access).
JIRA_EMAIL=you@yourcompany.com
# Generate at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Generate in Jira: QMetry > Configuration > Open API > Generate.
# This is NOT the same as the Automation API key.
QMETRY_API_KEY=

# --- Database ----------------------------------------------------------------
# A raw Postgres connection string (pgx), NOT the REST SUPABASE_URL the PSS
# uses. TDMS keeps its tables in its own `tdms` schema, so it can safely
# share a Supabase project with the PSS.
#   Local:    `docker compose up -d` starts a Postgres matching the line below.
#   Supabase: Dashboard > Settings > Database > Session pooler (or Direct
#             connection) URI. Use the Session pooler, not the Transaction
#             pooler — pgx's prepared statements don't survive pgbouncer's
#             transaction mode.
DATABASE_URL=postgres://tdms:tdms@localhost:5432/tdms?sslmode=disable

# --- Report emails (optional; leave SMTP_HOST empty to disable) --------------
# Port 587 uses STARTTLS, 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tdms@yourcompany.com

# --- Web server ----------------------------------------------------------------
# Public URL of the UI, used for "Full report" links in emails.
TDMS_BASE_URL=http://localhost:8080
# Listen port for `tdms serve` (or pass --addr). Many hosts set this for you.
# PORT=8080
# Days to keep each run's activity log (default 30). Run summaries and
# per-test-case results are kept forever; only the step-by-step lines expire.
# TDMS_LOG_RETENTION_DAYS=30
# Set to 1 only for plain-HTTP access on a non-localhost address during
# development; it drops the Secure flag from the session cookie.
# TDMS_INSECURE_COOKIES=1
