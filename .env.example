# Pick the base URL matching where your Jira Cloud site's data resides:
#   US:        https://qtmcloud.qmetry.com
#   Australia: https://syd-qtmcloud.qmetry.com
#   Germany:   https://eu-qtm4j-cloud.qmetry.com
QMETRY_BASE_URL=https://qtmcloud.qmetry.com

# Jira account used for Basic auth (any Jira user with QMetry access).
JIRA_EMAIL=you@yourcompany.com
# Generate at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Generate in Jira: QMetry > Configuration > Open API > Generate.
# This is NOT the same as the Automation API key.
QMETRY_API_KEY=

# Not used yet (storage isn't wired into cmd/tdms). Set this once the
# ingest routine starts persisting slots/instances.
DATABASE_URL=postgres://tdms:tdms@localhost:5432/tdms?sslmode=disable
